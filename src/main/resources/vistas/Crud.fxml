<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="520" minWidth="800" prefHeight="600" prefWidth="960" style="-fx-background-color: #060a12; -fx-font-family: 'Consolas'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thegrid.controller.CrudController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0a111d; -fx-padding: 12 20 12 20; -fx-border-color: #1aa7bd; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.5), 8, 0.2, 0, 0);" text="THE GRID" />
            <Separator maxHeight="18" orientation="VERTICAL" style="-fx-opacity: 0.5;" />
            <Label style="-fx-text-fill: #cfe9f0; -fx-font-size: 15px; -fx-font-weight: bold;" text="CRUD" />
            <Label fx:id="lblTablaActual" style="-fx-text-fill: #ff9a3c; -fx-font-size: 15px; -fx-font-weight: bold;" text="tabla" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalRegistros" style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="0 registros" />
        </HBox>
    </top>
    <center>
        <HBox spacing="16" style="-fx-padding: 16;">
            <VBox spacing="10" style="-fx-background-color: #0b1320; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="txtBuscar" onKeyReleased="#handleBuscar" promptText="buscar" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnRefrescar" onAction="#handleRefrescar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #00e5ff; -fx-text-fill: #00e5ff;" text="Refrescar" />
                </HBox>
                <TableView fx:id="tvRegistros" onKeyReleased="#handleRegistroTecla" onMouseClicked="#handleSeleccionarRegistro" style="-fx-background-color: #08101c; -fx-control-inner-background: #08101c; -fx-control-inner-background-alt: #0a1424; -fx-base: #0d1a33; -fx-text-base-color: #cfe9f0; -fx-selection-bar: #ff7a00; -fx-selection-bar-non-focused: #ff7a00; -fx-table-cell-border-color: rgba(0,229,255,0.12); -fx-border-color: #1aa7bd; -fx-border-radius: 3;" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="Sin registros" />
                    </placeholder>
                </TableView>
            </VBox>
            <VBox maxWidth="290" minWidth="270" prefWidth="280" spacing="10" style="-fx-background-color: #0b1320; -fx-border-color: #b85a00; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 20;">
                <Label style="-fx-text-fill: #ff9a3c; -fx-font-size: 16px; -fx-font-weight: bold;" text="Registro" />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="vbCampos" spacing="8" />
                </ScrollPane>
                <HBox spacing="8">
                    <Button fx:id="btnNuevo" maxWidth="Infinity" onAction="#handleNuevo" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #00e5ff; -fx-text-fill: #00e5ff;" text="Nuevo" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#handleGuardar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #ff7a00; -fx-text-fill: #ff9a3c; -fx-effect: dropshadow(gaussian, rgba(255,122,0,0.35), 8, 0.2, 0, 0);" text="Crear" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="8">
                    <Button fx:id="btnActualizar" maxWidth="Infinity" onAction="#handleActualizar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #ff7a00; -fx-text-fill: #ff9a3c; -fx-effect: dropshadow(gaussian, rgba(255,122,0,0.35), 8, 0.2, 0, 0);" text="Actualizar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#handleEliminar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #c2415a; -fx-text-fill: #ff6b85;" text="Eliminar" HBox.hgrow="ALWAYS" />
                </HBox>
                <Label fx:id="lblEstado" style="-fx-text-fill: #ff9a3c; -fx-font-size: 12px;" text="" wrapText="true" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #0a111d; -fx-padding: 8 20 8 20; -fx-border-color: #7a3d00; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnNavTablas" onAction="#handleIrTablas" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="Tablas" />
            <Button fx:id="btnNavCrud" onAction="#handleIrCrud" style="-fx-background-color: transparent; -fx-text-fill: #ff9a3c; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: #ff7a00;" text="CRUD" />
            <Button fx:id="btnNavIntegrantes" onAction="#handleIrIntegrantes" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="Integrantes" />
        </HBox>
    </bottom>
</BorderPane>
