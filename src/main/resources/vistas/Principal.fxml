<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="520" minWidth="800" prefHeight="600" prefWidth="960" style="-fx-background-color: #060a12; -fx-font-family: 'Consolas'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thegrid.controller.PrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0a111d; -fx-padding: 12 20 12 20; -fx-border-color: #1aa7bd; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.5), 8, 0.2, 0, 0);" text="THE GRID" />
            <Separator maxHeight="18" orientation="VERTICAL" style="-fx-opacity: 0.5;" />
            <Label style="-fx-text-fill: #cfe9f0; -fx-font-size: 15px; -fx-font-weight: bold;" text="Tablas" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblConexion" style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="" />
            <Button fx:id="btnDesconectar" onAction="#handleDesconectar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #c2415a; -fx-text-fill: #ff6b85; -fx-padding: 5 14 5 14;" text="Desconectar" />
        </HBox>
    </top>
    <left>
        <VBox prefWidth="250" spacing="10" style="-fx-padding: 16 8 16 16;">
            <Label style="-fx-text-fill: #ff9a3c; -fx-font-size: 16px; -fx-font-weight: bold;" text="Esquema its5a" />
            <TextField fx:id="txtBuscarTabla" onKeyReleased="#handleBuscarTabla" promptText="filtrar tablas" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" />
            <ListView fx:id="lvTablas" onKeyReleased="#handleTablaTecla" onMouseClicked="#handleSeleccionarTabla" style="-fx-background-color: #08101c; -fx-control-inner-background: #08101c; -fx-base: #0d1a33; -fx-text-base-color: #b8e6f0; -fx-selection-bar: #ff7a00; -fx-selection-bar-non-focused: #ff7a00; -fx-border-color: #1aa7bd; -fx-border-radius: 3; -fx-background-radius: 3;" VBox.vgrow="ALWAYS" />
            <Label fx:id="lblTotalTablas" style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="0 tablas" />
        </VBox>
    </left>
    <center>
        <VBox style="-fx-padding: 16 16 16 8;">
            <VBox spacing="10" style="-fx-background-color: #0b1320; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2">
                        <Label fx:id="lblTablaSeleccionada" style="-fx-text-fill: #00e5ff; -fx-font-size: 16px; -fx-font-weight: bold;" text="Selecciona una tabla" />
                        <Label fx:id="lblInfoTabla" style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="registros: -   columnas: -" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnDescargar" disable="true" onAction="#handleDescargar" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #ff7a00; -fx-text-fill: #ff9a3c; -fx-effect: dropshadow(gaussian, rgba(255,122,0,0.35), 8, 0.2, 0, 0);" text="Descargar" />
                </HBox>
                <TableView fx:id="tvVistaPrevia" style="-fx-background-color: #08101c; -fx-control-inner-background: #08101c; -fx-control-inner-background-alt: #0a1424; -fx-base: #0d1a33; -fx-text-base-color: #cfe9f0; -fx-selection-bar: #ff7a00; -fx-selection-bar-non-focused: #ff7a00; -fx-table-cell-border-color: rgba(0,229,255,0.12); -fx-border-color: #1aa7bd; -fx-border-radius: 3;" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="Vista previa de la tabla" />
                    </placeholder>
                </TableView>
                <ProgressBar fx:id="pbDescarga" maxWidth="Infinity" prefHeight="8" progress="0.0" style="-fx-accent: #ff7a00;" />
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="lblEstadoDescarga" style="-fx-text-fill: #ff9a3c; -fx-font-size: 12px;" text="" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnAbrirCrud" disable="true" onAction="#handleAbrirCrud" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #00e5ff; -fx-text-fill: #00e5ff;" text="Abrir en CRUD" />
                </HBox>
            </VBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #0a111d; -fx-padding: 8 20 8 20; -fx-border-color: #7a3d00; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnNavTablas" onAction="#handleIrTablas" style="-fx-background-color: transparent; -fx-text-fill: #ff9a3c; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: #ff7a00;" text="Tablas" />
            <Button fx:id="btnNavCrud" onAction="#handleIrCrud" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="CRUD" />
            <Button fx:id="btnNavIntegrantes" onAction="#handleIrIntegrantes" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="Integrantes" />
        </HBox>
    </bottom>
</BorderPane>
