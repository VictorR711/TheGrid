<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane minHeight="520" minWidth="800" prefHeight="600" prefWidth="960" style="-fx-background-color: #060a12; -fx-font-family: 'Consolas'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thegrid.controller.IntegrantesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0a111d; -fx-padding: 12 20 12 20; -fx-border-color: #1aa7bd; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.5), 8, 0.2, 0, 0);" text="THE GRID" />
            <Separator maxHeight="18" orientation="VERTICAL" style="-fx-opacity: 0.5;" />
            <Label style="-fx-text-fill: #cfe9f0; -fx-font-size: 15px; -fx-font-weight: bold;" text="Integrantes" />
        </HBox>
    </top>
    <center>
        <HBox alignment="CENTER" fillHeight="false" spacing="60" style="-fx-padding: 20;">
            <StackPane>
            <Circle radius="125" style="-fx-fill: transparent; -fx-stroke: #00e5ff; -fx-stroke-width: 3; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.8), 16, 0.2, 0, 0);" />
            <Circle radius="100" style="-fx-fill: transparent; -fx-stroke: #ff7a00; -fx-stroke-width: 2; -fx-stroke-dash-array: 12 7;" />
            <Circle radius="66" style="-fx-fill: transparent; -fx-stroke: #1aa7bd; -fx-stroke-width: 1;" />
            <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 17px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.6), 10, 0.2, 0, 0);" text="EQUIPO" />
        </StackPane>
            <VBox maxWidth="400" spacing="12" style="-fx-background-color: #0b1320; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 20;">
                <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 16px; -fx-font-weight: bold;" text="Equipo de desarrollo" />
                <Label fx:id="lblIntegrante1" style="-fx-text-fill: #cfe9f0; -fx-font-size: 14px;" text="1. Leidy Miriam Morayta Perez" />
                <Separator style="-fx-opacity: 0.35;" />
                <Label fx:id="lblIntegrante2" style="-fx-text-fill: #cfe9f0; -fx-font-size: 14px;" text="2. Angela Alicia Pimienta Diaz" />
                <Separator style="-fx-opacity: 0.35;" />
                <Label fx:id="lblIntegrante3" style="-fx-text-fill: #cfe9f0; -fx-font-size: 14px;" text="3. Victor Adrian Romero Minaya" />
                <Separator style="-fx-opacity: 0.35;" />
                <Label fx:id="lblIntegrante4" style="-fx-text-fill: #cfe9f0; -fx-font-size: 14px;" text="4. Diego Valadez Almeyda" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #0a111d; -fx-padding: 8 20 8 20; -fx-border-color: #7a3d00; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnNavTablas" onAction="#handleIrTablas" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="Tablas" />
            <Button fx:id="btnNavCrud" onAction="#handleIrCrud" style="-fx-background-color: transparent; -fx-text-fill: #6fb7c7; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: transparent;" text="CRUD" />
            <Button fx:id="btnNavIntegrantes" onAction="#handleIrIntegrantes" style="-fx-background-color: transparent; -fx-text-fill: #ff9a3c; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand; -fx-border-width: 0 0 2 0; -fx-border-color: #ff7a00;" text="Integrantes" />
        </HBox>
    </bottom>
</BorderPane>
