<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="520" minWidth="800" prefHeight="600" prefWidth="960" style="-fx-background-color: #060a12; -fx-font-family: 'Consolas'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thegrid.controller.ConexionDBController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0a111d; -fx-padding: 12 20 12 20; -fx-border-color: #1aa7bd; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.5), 8, 0.2, 0, 0);" text="THE GRID" />
            <Separator maxHeight="18" orientation="VERTICAL" style="-fx-opacity: 0.5;" />
            <Label style="-fx-text-fill: #cfe9f0; -fx-font-size: 15px; -fx-font-weight: bold;" text="Base de datos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblEstadoTunel" style="-fx-text-fill: #00e5ff; -fx-font-size: 12px;" text="Túnel activo" />
            <Label fx:id="lblHostTunel" style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" style="-fx-padding: 20;">
            <VBox maxWidth="400" spacing="8" style="-fx-background-color: #0b1320; -fx-border-color: #b85a00; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 20;">
                <Label style="-fx-text-fill: #ff9a3c; -fx-font-size: 16px; -fx-font-weight: bold;" text="Conectar a MariaDB" />
                <Label style="-fx-text-fill: #5f7a8c; -fx-font-size: 11px;" text="La conexión pasa por el túnel SSH" />
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #6fb7c7; -fx-font-size: 11px;" text="Host" />
                        <TextField fx:id="txtHostDB" onAction="#handleHostDBEnter" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" text="localhost" />
                    </VBox>
                    <VBox prefWidth="90" spacing="4">
                        <Label style="-fx-text-fill: #6fb7c7; -fx-font-size: 11px;" text="Puerto" />
                        <TextField fx:id="txtPuertoDB" onAction="#handlePuertoDBEnter" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" text="3306" />
                    </VBox>
                </HBox>
                <Label style="-fx-text-fill: #6fb7c7; -fx-font-size: 11px;" text="Esquema" />
                <TextField fx:id="txtEsquema" onAction="#handleEsquemaEnter" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" text="its5a" />
                <Label style="-fx-text-fill: #6fb7c7; -fx-font-size: 11px;" text="Usuario" />
                <TextField fx:id="txtUsuarioDB" onAction="#handleUsuarioDBEnter" promptText="usuario de MariaDB" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" />
                <Label style="-fx-text-fill: #6fb7c7; -fx-font-size: 11px;" text="Contraseña" />
                <PasswordField fx:id="txtPasswordDB" onAction="#handleConectarDB" promptText="contraseña de MariaDB" style="-fx-background-color: #08101c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #4d6577; -fx-border-color: #1aa7bd; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 7 9 7 9;" />
                <HBox spacing="10" style="-fx-padding: 8 0 0 0;">
                    <Button fx:id="btnConectarDB" maxWidth="Infinity" onAction="#handleConectarDB" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #ff7a00; -fx-text-fill: #ff9a3c; -fx-effect: dropshadow(gaussian, rgba(255,122,0,0.35), 8, 0.2, 0, 0);" text="Conectar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCerrarTunel" onAction="#handleCerrarTunel" style="-fx-background-color: #0b1320; -fx-border-width: 1.5; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-cursor: hand; -fx-border-color: #c2415a; -fx-text-fill: #ff6b85;" text="Cerrar túnel" />
                </HBox>
                <Label fx:id="lblEstado" style="-fx-text-fill: #ff9a3c; -fx-font-size: 12px;" text="" wrapText="true" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
